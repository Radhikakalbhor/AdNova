# Groq API Key for AdNova (Required for ad copy and variation generation)
# Obtain your free API key from Groq Console: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Optional: Pollinations API Key for unlimited/unthrottled photorealistic image generation
# If omitted, AdNova uses the free anonymous tier (1 image every 45s per IP) and displays high-resolution creative vector artwork during cooldown.
# Obtain your key from: https://enter.pollinations.ai/
POLLINATIONS_API_KEY=your_pollinations_api_key_here
